# Copy this file to .env, change all placeholders, then protect .env with chmod 600.
# APP_HOST keeps existing LAN access. Public browser and PWA traffic must use Nginx HTTPS.
APP_HOST=0.0.0.0
APP_PORT=32765
PUBLIC_BASE_URL=https://radar.example.com
DATA_DIR=./data

# The first start creates this administrator only when no administrator exists.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-first-start

# HTTPS uses a Secure cookie. Direct HTTP login is allowed only for private LAN peers.
ALLOW_LAN_HTTP_LOGIN=true
TRUSTED_PROXY_IPS=127.0.0.1,::1
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=180
SESSION_RENEWAL_WARNING_DAYS=14

# Background timers use these values when their systemd units run.
UPDATE_INTERVAL_SECONDS=900
HERO_UPDATE_INTERVAL_SECONDS=86400
MAX_GENERATED_UPDATES=80
MAX_IMAGE_CACHE_BYTES=268435456

# Configure exactly one AI reviewer method when automatic AI review is wanted.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
AI_REVIEW_COMMAND=
OPENAI_API_KEY=
OPENAI_MODEL=
VAPID_SUBJECT=mailto:admin@example.com
