[Unit]
Description=NMIXX Radar web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nmixx-radar
Group=nmixx-radar
WorkingDirectory=/opt/nmixx-radar
EnvironmentFile=/opt/nmixx-radar/.env
Environment=PATH=/home/nmixx-radar/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env uv run --frozen uvicorn app.main:app --host 0.0.0.0 --port 32765 --proxy-headers --forwarded-allow-ips=127.0.0.1,::1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/nmixx-radar/data

[Install]
WantedBy=multi-user.target
